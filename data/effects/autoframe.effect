// Converts the captured input into an SDR, sRGB-encoded frame for the detector.
// The input is always bound as sRGB, so samples arrive in linear light; encoding is done here because the
// detector reads raw bytes and needs the non-linear values a camera would produce.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float multiplier;

sampler_state linearSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv = v_in.uv;
	return v_out;
}

float srgb_encode_channel(float u)
{
	return (u <= 0.0031308) ? (12.92 * u) : ((1.055 * pow(u, 1.0 / 2.4)) - 0.055);
}

float3 srgb_encode(float3 v)
{
	return float3(srgb_encode_channel(v.r), srgb_encode_channel(v.g), srgb_encode_channel(v.b));
}

float3 rec709_to_rec2020(float3 v)
{
	float r = dot(v, float3(0.62740389593469903, 0.32928303837788370, 0.043313065687417225));
	float g = dot(v, float3(0.069097289358232075, 0.91954039507545871, 0.011362315566309178));
	float b = dot(v, float3(0.016391438875150280, 0.088013307877225749, 0.89559525324762401));
	return float3(r, g, b);
}

float3 rec2020_to_rec709(float3 v)
{
	float r = dot(v, float3(1.6604910021084345, -0.58764113878854951, -0.072849863319884883));
	float g = dot(v, float3(-0.12455047452159074, 1.1328998971259603, -0.0083494226043694768));
	float b = dot(v, float3(-0.018150763354905303, -0.10057889800800739, 1.1187296613629127));
	return float3(r, g, b);
}

float3 reinhard(float3 rgb)
{
	return rgb / (rgb + 1.0);
}

float3 tonemap(float3 rgb)
{
	return rec2020_to_rec709(reinhard(rec709_to_rec2020(rgb)));
}

float4 PSDetectSdr(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(linearSampler, v_in.uv);
	return float4(srgb_encode(saturate(rgba.rgb)), 1.0);
}

float4 PSDetectTonemap(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(linearSampler, v_in.uv);
	return float4(srgb_encode(saturate(tonemap(rgba.rgb))), 1.0);
}

float4 PSDetectMultiplyTonemap(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(linearSampler, v_in.uv);
	return float4(srgb_encode(saturate(tonemap(rgba.rgb * multiplier))), 1.0);
}

technique DetectSdr
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDetectSdr(v_in);
	}
}

technique DetectTonemap
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDetectTonemap(v_in);
	}
}

technique DetectMultiplyTonemap
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDetectMultiplyTonemap(v_in);
	}
}
